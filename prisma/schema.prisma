  bookings            bookings[]
  vehicle_media       vehicle_media[]
  vehicles            vehicles[]
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model vehicles {
  id                  String                @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  vehicle_type_id     String                @db.Uuid
  display_name        String
  internal_code       String?               @unique
  registration_number String?
  passenger_capacity  Int?
  luggage_capacity    Int?
  status              content_status        @default(PUBLISHED)
  operational_notes   String?
  created_at          DateTime              @default(now()) @db.Timestamptz(6)
  updated_at          DateTime              @default(now()) @db.Timestamptz(6)
  archived_at         DateTime?             @db.Timestamptz(6)
  availability_blocks availability_blocks[]
  bookings            bookings[]
  vehicle_types       vehicle_types         @relation(fields: [vehicle_type_id], references: [id], onUpdate: NoAction)

  @@index([vehicle_type_id, status], map: "vehicles_type_status_idx")
}

enum admin_role {
  OWNER
  ADMIN
  EDITOR
}

enum availability_block_type {
  MAINTENANCE
  UNAVAILABLE
  PRIVATE_USE
  OTHER
}

enum booking_status {
  NEW_REQUEST
  CONTACT_PENDING
  QUOTATION_SENT
  CONFIRMED
  IN_PROGRESS
  COMPLETED
  CANCELLED
  REJECTED
}

enum booking_type {
  TOUR
  VEHICLE
  TRANSFER
  CUSTOM
}

enum content_status {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum media_kind {
  IMAGE
  VIDEO
}

enum moderation_status {
  PENDING
  APPROVED
  REJECTED
  HIDDEN
}

enum payment_status {
  NOT_REQUIRED
  PENDING
  PARTIALLY_PAID
  PAID
  REFUND_PENDING
  PARTIALLY_REFUNDED
  REFUNDED
  FAILED
}

enum pricing_model {
  PER_PERSON
  PER_BOOKING
  PER_VEHICLE
  PER_HOUR
  PER_DAY
  PER_DISTANCE
  QUOTE_REQUIRED
}

enum service_type {
  TOUR
  TRANSFER
  EXPERIENCE
  CUSTOM
}
